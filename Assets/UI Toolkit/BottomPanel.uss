#BottomPanel {
    position: absolute;
    bottom: 0;
    left: 0;
    width: 100%;
    height: 150px;
    flex-direction: row;
    background-color: rgba(0, 0, 0, 0.7);
    padding-top: 5px;
    padding-right: 5px;
    padding-bottom: 5px;
    padding-left: 5px;
}

#BottomPanel > #MinimapContainer {
    height: 100%;
    border-top-width: 2px;
    border-right-width: 2px;
    border-bottom-width: 2px;
    border-left-width: 2px;
    border-left-color: rgb(255, 255, 255);
    border-right-color: rgb(255, 255, 255);
    border-top-color: rgb(255, 255, 255);
    border-bottom-color: rgb(255, 255, 255);
    margin-right: 5px;
    width: 150px;
}

#BottomPanel > #BuildButtonsContainer {
    height: 141px;
    flex-direction: row;
    flex-wrap: wrap;
    flex-shrink: 1;
    flex-basis: 571px;
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
    align-content: stretch;
    justify-content: space-between;
}

#BottomPanel > #InfoPanel {
    height: 100%;
    flex-grow: 1;
    background-color: rgba(255, 255, 255, 0.25);
    margin-left: 5px;
}

.action-slot {
    width: 67px;
    height: 67px;
    border-top-width: 1px;
    border-right-width: 1px;
    border-bottom-width: 1px;
    border-left-width: 1px;
    border-left-color: rgb(255, 0, 0);
    border-right-color: rgb(255, 0, 0);
    border-top-color: rgb(255, 0, 0);
    border-bottom-color: rgb(255, 0, 0);
    background-color: rgb(255, 255, 255);
    margin-top: 0;
    margin-right: 0;
    margin-bottom: 0;
    margin-left: 0;
    padding-top: 0;
    padding-right: 0;
    padding-bottom: 0;
    padding-left: 0;
}
